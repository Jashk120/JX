# mirror-node environment — copy to .env and edit
# real environment variables override .env; .env overrides built-in defaults

# Directory watched when MIRROR_BLOCK_NODE_URL is empty
MIRROR_STREAMS_DIR=./data/streams

# Local state: the default keeps the in-memory store. A postgres:// DSN
# enables the PostgreSQL backend, e.g.
# MIRROR_DB_PATH=postgres://mirror:mirror@localhost:5432/mirror?sslmode=disable
MIRROR_DB_PATH=./data/mirror.db

# HTTP API listen address
MIRROR_API_ADDR=:8080

# Log level: debug, info, warn, error
MIRROR_LOG_LEVEL=info

# Ed25519 verifying key (32 bytes, 64 hex chars) — required
MIRRORD_PUBKEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Trusted roster hash anchor (32 bytes, 64 hex chars) — required
MIRRORD_TRUSTED_ROSTER_HASH=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Remote block-node base URL — when set, the mirror polls the block node
# instead of scanning MIRROR_STREAMS_DIR. Example: http://block-node:8080
MIRROR_BLOCK_NODE_URL=
